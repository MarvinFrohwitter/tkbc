KITES 2
BEGIN

        MOVE_ADD KITES 0 -50 1

        MOVE_ADD (0 1 2) 0 -30 5
        MOVE KITES 500 300 5
        MOVE (0 1 2) 500 300 5

        TIP_ROTATION KITES 180 RIGHT 2
        TIP_ROTATION KITES 180 LEFT 2
        TIP_ROTATION_ADD KITES 180 LEFT 2
        TIP_ROTATION_ADD KITES 180 RIGHT 2

        ROTATION KITES 180 2
    {
        ROTATION_ADD KITES 180 2
        WAIT 2
        QUIT 100
    }
END
